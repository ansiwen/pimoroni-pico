;
; PIO programs for HUB75 panels using S-PWM driver chips (SM16380SH, ICND2055, FM6373, ...)
;
; Ported from the DMD_STM32 library by Dmitry Dmitriev (board707):
; https://github.com/board707/DMD_STM32 (dmd_spwm.pio.h)
;
; SPDX-License-Identifier: GPL-3.0-or-later
;

.program hub75_spwm_frame
.side_set 2

; side-set pins are CLK (bit 0) and LAT (bit 1)
; OUT pins are R0, G0, B0, R1, G1, B1, or only R0, G0, B0 for panels that only
; use those (Hub75SPWM::Lanes::SINGLE)
;
; Clocks out a frame from the compact frame buffer. Every chip receives one
; 16-bit word per channel, MSB first, of which only bits 13..4 (with
; 14 greyscale bits) carry data. The buffer only holds those 10 clocks, as two
; 32-bit words of 5 clocks * 6 bits, or one word of 10 clocks * 3 bits with only
; R0, G0, B0 (autopull at 30 bits, `out pins` patched to 3). This program adds
; the 2 leading and 4 trailing zero clocks, and raises LAT on the last clock of
; the last chip in the chain (a data latch).
;
; ISR = number of chips in the chain - 1, loaded by the CPU with pio_sm_exec.
; The number of leading and trailing zero clocks are patched by the CPU for
; chips with a different number of greyscale bits (lead_count, trail_count).
;
; The clock waveform matches hub75_spwm_regs: RGB changes 3 cycles after the
; falling edge, 1 cycle before the rising edge, CLK is high for 2 cycles.
; Stalls in `out pins` with CLK low when the FIFO runs empty.

.wrap_target
    mov y, isr          side 0b00 [1]   ; Chips in the chain - 1
word:
public lead_count:
    set x, 1            side 0b00       ; Leading zero clocks - 1 (RGB is already 0)
lead:
    nop                 side 0b01 [1]
    jmp x-- lead        side 0b00 [2]
    set x, 9            side 0b00       ; 10 data clocks
public data:
    out pins, 6         side 0b00       ; 3 with only R0, G0, B0
    nop                 side 0b01 [1]
    jmp x-- data        side 0b00 [2]
    mov pins, null      side 0b00
public trail_count:
    set x, 2            side 0b00       ; Trailing zero clocks - 2
trail:
    nop                 side 0b01 [1]
    jmp x-- trail       side 0b00 [2]
    jmp !y, last        side 0b00
    nop                 side 0b01 [1]   ; Last trailing zero clock
    jmp y-- word        side 0b00 [2]   ; Next chip (y is not 0 here)
last:
    nop                 side 0b10 [3]   ; Last chip: raise LAT
    nop                 side 0b11 [1]   ; Last trailing zero clock with LAT
    nop                 side 0b10 [2]   ; LAT goes low at the start of the next chain
.wrap


.program hub75_spwm_regs
.side_set 1

; side-set pin is CLK
; OUT pins are R0, G0, B0, R1, G1, B1
; SET pin is LAT
;
; Sends register commands. The first FIFO word is a control word:
; - number of clocks - 1 (16 LSBs)
; - number of clocks - number of LAT clocks - 1 (16 MSBs)
; followed by 4 clocks per FIFO word, one byte each (LSB first) with the 6 RGB
; bits in its LSBs (autopull at 32 bits).
;
; LAT is raised for the last N clocks, which is how these chips distinguish a
; data latch (1 clock) from a register write (5 clocks) etc.
; Stalls in `out x` when done, then the CPU returns RGB to 0.

.wrap_target
    out x, 16           side 0          ; Clock count
    out y, 16           side 0          ; Clocks before LAT goes high
loop:
    out pins, 6         side 0          ; Output R0, G0, B0, R1, G1, B1
    out null, 2         side 1 [1]      ; Rising edge on CLK
    jmp y--, no_latch   side 0
    set pins, 1         side 0          ; Assert LAT for the remaining clocks
no_latch:
    jmp x--, loop       side 0 [1]
    set pins, 0         side 0
.wrap


.program hub75_spwm_clk_lat
.side_set 1

; side-set pin is CLK
; OUT pin is LAT
;
; Each FIFO word produces a single CLK pulse with LAT held at the level given
; by the LSB. This is used to send the "N clocks with LAT high"
; commands (VSYNC, pre-active, ...) that configure the driver chips.
;
; Jumping to `free_run` generates a continuous CLK (DCLK), which the chips use
; as the reference clock for their internal PWM.

.wrap_target
    pull block          side 0
    out pins, 1         side 0
    out null, 31        side 1 [1]
.wrap
public free_run:
    nop                 side 0
    jmp free_run        side 1


.program hub75_spwm_clk_cnt
.side_set 1 opt

; IN pin is CLK
; Side-set and OUT pin is OE (used as GCLK), OUT is only used by exec
;
; Counts CLK rising edges and drives OE through three segments per scan line:
; low, high, low. ISR holds a control word: the number of CLKs - 1 of the first
; segment (8 bits, LSBs), the number of scan lines - 1 between two first rows
; (16 bits) and the number of CLKs - 1 of the third segment (8 bits). The
; second segment's CLKs - 1 are patched into `set x` at w4 by the CPU.
; Y holds the scan lines left until the next first row. Both are loaded by the
; CPU with pio_sm_exec before the SM is enabled.
; At the start of each scan line, IRQ 0 is raised so hub75_spwm_rows switches
; the row address lines.
; The first row of every loop through all scan lines and groups gets a 12 CLK
; OE pulse instead (chips like the ICND2055 and FM6373 count rows that way).
; With Y = 0xffffffff at the start, this never happens within a frame.
; At 25MHz (6 cycles per CLK) this path is one instruction too long, and the
; 12 CLK pulse becomes 13 CLKs; the other pulses and the line lengths stay exact.
;
; The segments are unrolled so that only a few instructions run between the
; last CLK of a segment and the wait for the next one: at 25MHz (6 cycles per
; CLK) a loop over the segments missed one CLK per scan line.

.wrap_target
    mov osr, isr
    out x, 8            side 0  ; First segment, OE low
    irq nowait 0                ; hub75_spwm_rows selects the next row
count1:
    wait 0 pin 0
    wait 1 pin 0
    jmp x--, count1
    jmp y--, other_rows
    out y, 16                   ; First row of a loop: 12 CLKs, reload Y
    set x, 11           side 1
    jmp count2
other_rows:
    out null, 16
public w4:
    set x, 3            side 1  ; Second segment, OE high, patched: CLKs - 1
count2:
    wait 0 pin 0
    wait 1 pin 0
    jmp x--, count2
    out x, 8            side 0  ; Third segment, OE low
count3:
    wait 0 pin 0
    wait 1 pin 0
    jmp x--, count3
.wrap


.program hub75_spwm_rows

; OUT pins are row select A-E
;
; Selects the next row at the start of every scan line (IRQ 0 from
; hub75_spwm_clk_cnt), so the row address always follows the chips' internal
; row counter, however busy the CPU is. Raises IRQ 1 when it selects row 0, the
; start of a frame, for the CPU.
; X holds ~row, Y holds ~number of scan lines. Both are loaded by the CPU with
; pio_sm_exec, which also outputs row 0, before the SM is enabled. With more
; than 32 scan lines, A-E repeat rows 0-31.

.wrap_target
    wait 1 irq 0
    jmp x--, check      ; Next row
check:
    jmp x!=y, output
    mov x, ~null        ; Past the last row, back to row 0
    irq nowait 1
output:
    mov pins, ~x
.wrap


.program hub75_spwm_rows_shift

; OUT pins are row select A-E
;
; For row drivers that are shift registers: at the start of every scan line
; (IRQ 0 from hub75_spwm_clk_cnt), clocks the selected row one output further,
; or a new one in for row 0. Raises IRQ 1 when it selects row 0.
; ISR holds two sequences of 3 states of the A-E pins, 5 bits each, eg. data
; and latch, then clock, then all low: bits 0-14 select row 0, bits 15-29 the
; next row. Y holds the number of scan lines - 1, X the scan lines left until
; row 0. All are loaded by the CPU with pio_sm_exec before the SM is enabled.
; Each state lasts 32 cycles.

.wrap_target
    wait 1 irq 0
    mov osr, isr
    jmp x--, other_row
    mov x, y            ; Row 0
    irq nowait 1
    jmp output
other_row:
    out null, 15        ; The sequence for the next row
output:
    out pins, 5 [31]
    out pins, 5 [31]
    out pins, 5 [31]
.wrap

% c-sdk {
static inline pio_sm_config hub75_spwm_frame_program_init(PIO pio, uint sm, uint offset, float clkdiv, uint rgb_base_pin, uint clk_pin) {
    // CLK and LAT must be consecutive
    pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 2, true);
    for (uint i = rgb_base_pin; i < rgb_base_pin + 6; ++i)
        pio_gpio_init(pio, i);
    pio_gpio_init(pio, clk_pin);
    pio_gpio_init(pio, clk_pin + 1);

    pio_sm_config c = hub75_spwm_frame_program_get_default_config(offset);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_out_pins(&c, rgb_base_pin, 6);
    sm_config_set_sideset_pins(&c, clk_pin);
    sm_config_set_out_shift(&c, true, true, 30);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);
    return c;
}

// Set the number of leading and trailing zero clocks around the 10 data clocks
static inline void hub75_spwm_frame_set_zeros(PIO pio, uint offset, uint lead, uint trail) {
    pio->instr_mem[offset + hub75_spwm_frame_offset_lead_count] = pio_encode_set(pio_x, lead - 1);
    pio->instr_mem[offset + hub75_spwm_frame_offset_trail_count] = pio_encode_set(pio_x, trail - 2);
}

// Send 6 bits per clock (R0, G0, B0, R1, G1, B1, 2 words per channel) or 3 (R0,
// G0, B0, 1 word per channel). Only while the SM is stopped.
static inline void hub75_spwm_frame_set_lanes(PIO pio, uint offset, pio_sm_config *c, uint rgb_base_pin, uint lanes) {
    pio->instr_mem[offset + hub75_spwm_frame_offset_data] = pio_encode_out(pio_pins, 3 * lanes);
    sm_config_set_out_pins(c, rgb_base_pin, 3 * lanes);
}

static inline pio_sm_config hub75_spwm_regs_program_init(PIO pio, uint sm, uint offset, float clkdiv, uint rgb_base_pin, uint lat_pin, uint clk_pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
    pio_sm_set_consecutive_pindirs(pio, sm, lat_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, true);
    for (uint i = rgb_base_pin; i < rgb_base_pin + 6; ++i)
        pio_gpio_init(pio, i);
    pio_gpio_init(pio, lat_pin);
    pio_gpio_init(pio, clk_pin);

    pio_sm_config c = hub75_spwm_regs_program_get_default_config(offset);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_out_pins(&c, rgb_base_pin, 6);
    sm_config_set_set_pins(&c, lat_pin, 1);
    sm_config_set_sideset_pins(&c, clk_pin);
    sm_config_set_out_shift(&c, true, true, 32);
    pio_sm_init(pio, sm, offset, &c);
    return c;
}

static inline pio_sm_config hub75_spwm_clk_lat_program_init(PIO pio, uint sm, uint offset, float clkdiv, uint lat_pin, uint clk_pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, lat_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, true);
    pio_gpio_init(pio, lat_pin);
    pio_gpio_init(pio, clk_pin);

    pio_sm_config c = hub75_spwm_clk_lat_program_get_default_config(offset);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_out_pins(&c, lat_pin, 1);
    sm_config_set_sideset_pins(&c, clk_pin);
    sm_config_set_out_shift(&c, true, false, 32);
    pio_sm_init(pio, sm, offset, &c);
    return c;
}

static inline pio_sm_config hub75_spwm_clk_cnt_program_init(PIO pio, uint sm, uint offset, float clkdiv, uint clk_pin, uint oe_pin) {
    pio_sm_set_consecutive_pindirs(pio, sm, oe_pin, 1, true);
    pio_gpio_init(pio, oe_pin);

    pio_sm_config c = hub75_spwm_clk_cnt_program_get_default_config(offset);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_in_pins(&c, clk_pin);
    sm_config_set_out_pins(&c, oe_pin, 1);
    sm_config_set_sideset_pins(&c, oe_pin);
    sm_config_set_out_shift(&c, true, false, 32);
    pio_sm_init(pio, sm, offset, &c);
    return c;
}

static inline pio_sm_config hub75_spwm_rows_program_init(PIO pio, uint sm, uint offset, uint row_base_pin, bool shift) {
    pio_sm_set_consecutive_pindirs(pio, sm, row_base_pin, 5, true);
    for (uint i = row_base_pin; i < row_base_pin + 5; ++i)
        pio_gpio_init(pio, i);

    pio_sm_config c = shift ? hub75_spwm_rows_shift_program_get_default_config(offset)
                            : hub75_spwm_rows_program_get_default_config(offset);
    sm_config_set_out_pins(&c, row_base_pin, 5);
    sm_config_set_out_shift(&c, true, false, 32);
    pio_sm_init(pio, sm, offset, &c);
    return c;
}

// Wait until a state machine has consumed its whole TX FIFO and stalled on a PULL
static inline void hub75_spwm_wait_tx_stall(PIO pio, uint sm) {
    uint32_t txstall_mask = 1u << (PIO_FDEBUG_TXSTALL_LSB + sm);
    pio->fdebug = txstall_mask;
    while (!(pio->fdebug & txstall_mask))
        tight_loop_contents();
}
%}
